classDiagram
    %% PawPal+ class design (draft) — keep in sync with implementation.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +add_pet(pet) None
        +set_available_time(minutes) None
        +set_preference(key, value) None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +list_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str preferred_time
        +bool recurring
        +priority_score() int
        +fits_within(remaining_minutes) bool
    }

    class Scheduler {
        +Owner owner
        +Pet pet
        +int time_budget
        +build_plan() Plan
        +sort_tasks(tasks) list~Task~
        +filter_tasks(tasks, budget) list~Task~
    }

    class Plan {
        +list~ScheduledTask~ entries
        +int total_minutes
        +list~Task~ skipped_tasks
        +add_entry(scheduled_task) None
        +explain() str
        +to_table() list~dict~
    }

    class ScheduledTask {
        +Task task
        +str start_time
        +str end_time
        +str reason
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : uses
    Scheduler --> Pet : schedules
    Scheduler ..> Plan : produces
    Plan "1" --> "*" ScheduledTask : contains
    ScheduledTask --> Task : wraps
